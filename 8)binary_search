      "source": [
        "def binarySearch(arr, l, r, x):\n",
        "    if r >= l:\n",
        "        mid = l + (r - l) // 2  # Use integer division //\n",
        "        midd = int(mid) # mid is already an int due to //, but keeping for clarity\n",
        "        if arr[midd] == x:\n",
        "            return midd\n",
        "        elif arr[midd] > x:\n",
        "            return binarySearch(arr, l, midd - 1, x)\n",
        "        else:  # arr[midd] < x\n",
        "            return binarySearch(arr, midd + 1, r, x)\n",
        "    else:\n",
        "        return -1\n",
        "\n",
        "\n",
        "arr = [ 2, 3, 4, 10, 40 ]\n",
        "x = 10\n",
        "\n",
        "result = binarySearch(arr, 0, len(arr) - 1, x)\n",
        "if result != -1:\n",
        "    print(\"Element is present at index % d\" % result)\n",
        "else:\n",
        "    print(\"Element is not present in array\")"
      ]
    }
